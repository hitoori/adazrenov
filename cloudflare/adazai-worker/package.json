{
  "name": "adazai-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:create": "wrangler d1 create adazai-conversations",
    "db:migrate:local": "wrangler d1 execute adazai-conversations --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute adazai-conversations --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
